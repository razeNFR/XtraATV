<androidx.preference.PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <Preference
        android:key="tv_1440p_warning"
        android:layout="@layout/tv_preference_warning"
        android:selectable="false"
        android:title="@string/tv_1440p_warning"
        app:isPreferenceVisible="@bool/isTv" />

    <!-- 1. Appearance & General -->
    <PreferenceCategory
        android:title="@string/mobile_settings_cat_general"
        app:iconSpaceReserved="false">

        <ListPreference
            android:defaultValue="auto"
            android:entries="@array/languageEntries"
            android:entryValues="@array/language"
            android:icon="@drawable/tv_ic_globe"
            android:key="ui_language"
            android:summary="%s"
            android:title="@string/language"
            app:singleLineTitle="false" />

        <Preference
            android:icon="@drawable/tv_ic_palette"
            android:key="theme_settings"
            android:title="@string/theme"
            app:singleLineTitle="false" />

        <Preference
            android:icon="@drawable/tv_ic_view_quilt"
            android:key="ui_settings"
            android:title="@string/ui_settings"
            app:singleLineTitle="false" />

        <SwitchPreferenceCompat
            android:defaultValue="false"
            android:key="ui_draw_behind_cutouts"
            android:title="@string/draw_behind_cutouts"
            app:iconSpaceReserved="false"
            app:singleLineTitle="false" />

        <SwitchPreferenceCompat
            android:defaultValue="false"
            android:icon="@drawable/tv_ic_bell"
            android:key="live_notifications_enabled"
            android:title="@string/live_notifications"
            app:singleLineTitle="false" />

    </PreferenceCategory>

    <!-- 2. Adblock & Proxies -->
    <PreferenceCategory
        android:title="@string/mobile_settings_cat_adblock"
        app:iconSpaceReserved="false">

        <Preference
            android:icon="@drawable/tv_ic_shield"
            android:key="adblock_settings"
            android:title="@string/adblock"
            app:singleLineTitle="false" />

        <SwitchPreferenceCompat
            android:defaultValue="false"
            android:icon="@drawable/tv_ic_proxy"
            android:key="player_use_custom_proxy"
            android:title="@string/use_custom_proxies"
            app:singleLineTitle="false" />

        <Preference
            android:key="custom_proxy_settings"
            android:title="@string/custom_proxy_settings"
            app:iconSpaceReserved="false"
            app:singleLineTitle="false" />

        <SwitchPreferenceCompat
            android:defaultValue="false"
            android:icon="@drawable/tv_ic_wifi"
            android:key="player_use_stream_proxy"
            android:title="@string/use_stream_proxies"
            app:singleLineTitle="false" />

        <Preference
            android:key="stream_proxy_settings"
            android:title="@string/proxy_settings"
            app:iconSpaceReserved="false"
            app:singleLineTitle="false" />

    </PreferenceCategory>

    <!-- 3. Player -->
    <PreferenceCategory
        android:title="@string/mobile_settings_cat_player"
        app:iconSpaceReserved="false">

        <Preference
            android:icon="@drawable/tv_ic_play"
            android:key="player_settings"
            android:title="@string/player_settings"
            app:singleLineTitle="false" />

        <Preference
            android:icon="@drawable/tv_ic_tune"
            android:key="player_button_settings"
            android:title="@string/player_buttons"
            app:singleLineTitle="false" />

        <SwitchPreferenceCompat
            android:defaultValue="true"
            android:icon="@drawable/tv_ic_history"
            android:key="mobile_live_dvr"
            android:summary="@string/mobile_live_dvr_summary"
            android:title="@string/mobile_live_dvr_title"
            app:singleLineTitle="false" />

        <SwitchPreferenceCompat
            android:defaultValue="true"
            android:icon="@drawable/tv_ic_hd"
            android:key="mobile_hud_show_quality"
            android:summary="@string/mobile_hud_show_quality_summary"
            android:title="@string/mobile_hud_show_quality_title"
            app:singleLineTitle="false" />

        <SwitchPreferenceCompat
            android:defaultValue="true"
            android:icon="@drawable/tv_ic_eye"
            android:key="mobile_hud_show_viewers"
            android:summary="@string/mobile_hud_show_viewers_summary"
            android:title="@string/mobile_hud_show_viewers_title"
            app:singleLineTitle="false" />

        <SwitchPreferenceCompat
            android:defaultValue="true"
            android:key="player_show_uptime"
            android:summary="@string/mobile_hud_show_uptime_summary"
            android:title="@string/show_uptime"
            app:iconSpaceReserved="false"
            app:singleLineTitle="false" />

        <SwitchPreferenceCompat
            android:defaultValue="true"
            android:icon="@drawable/tv_ic_pip"
            android:key="player_picture_in_picture"
            android:title="@string/picture_in_picture"
            app:singleLineTitle="false" />

        <SwitchPreferenceCompat
            android:defaultValue="true"
            android:key="player_background_audio"
            android:title="@string/use_background_audio"
            app:iconSpaceReserved="false"
            app:singleLineTitle="false" />

        <SwitchPreferenceCompat
            android:defaultValue="true"
            android:key="player_background_audio_locked"
            android:title="@string/use_background_audio_locked"
            app:iconSpaceReserved="false"
            app:singleLineTitle="false" />

        <SwitchPreferenceCompat
            android:defaultValue="false"
            android:icon="@drawable/tv_ic_volume"
            android:key="tv_vod_audio_recovery"
            android:summary="@string/tv_vod_audio_recovery_summary"
            android:title="@string/tv_vod_audio_recovery"
            app:singleLineTitle="false" />

        <SwitchPreferenceCompat
            android:defaultValue="true"
            android:key="tv_sync_vod_history"
            android:summary="@string/tv_sync_vod_history_summary"
            android:title="@string/tv_sync_vod_history"
            app:iconSpaceReserved="false"
            app:singleLineTitle="false" />

        <SwitchPreferenceCompat
            android:defaultValue="false"
            android:key="tv_clips_autoplay"
            android:summary="@string/tv_clips_autoplay_summary"
            android:title="@string/tv_clips_autoplay"
            app:iconSpaceReserved="false"
            app:singleLineTitle="false" />

        <Preference
            android:key="playback_settings"
            android:title="@string/playback_settings"
            app:iconSpaceReserved="false"
            app:singleLineTitle="false" />

        <Preference
            android:key="buffer_settings"
            android:title="@string/buffer_settings"
            app:iconSpaceReserved="false"
            app:singleLineTitle="false" />

    </PreferenceCategory>

    <!-- 4. Chat -->
    <PreferenceCategory
        android:title="@string/mobile_settings_cat_chat"
        app:iconSpaceReserved="false">

        <Preference
            android:icon="@drawable/tv_ic_chat"
            android:key="chat_settings"
            android:title="@string/chat_settings"
            app:singleLineTitle="false" />

    </PreferenceCategory>

    <!-- 5. Data & Personalization -->
    <PreferenceCategory
        android:title="@string/mobile_settings_cat_data"
        app:iconSpaceReserved="false">

        <Preference
            android:icon="@drawable/tv_ic_bar_chart"
            android:key="mobile_stats"
            android:summary="@string/mobile_stats_summary"
            android:title="@string/mobile_stats_title"
            app:singleLineTitle="false" />

        <Preference
            android:icon="@drawable/tv_ic_star"
            android:key="tv_favorites"
            android:title="@string/tv_favorites"
            app:singleLineTitle="false" />

        <Preference
            android:icon="@drawable/tv_ic_block"
            android:key="tv_blacklist"
            android:title="@string/tv_blacklist_title"
            app:singleLineTitle="false" />

        <Preference
            android:icon="@drawable/tv_ic_download"
            android:key="download_settings"
            android:title="@string/download_settings"
            app:singleLineTitle="false" />

        <Preference
            android:icon="@drawable/tv_ic_share"
            android:key="backup_settings"
            android:title="@string/backup_settings"
            app:singleLineTitle="false" />

        <Preference
            android:icon="@drawable/tv_ic_history"
            android:key="restore_settings"
            android:title="@string/restore_settings"
            app:singleLineTitle="false" />

    </PreferenceCategory>

    <!-- 6. System & About -->
    <PreferenceCategory
        android:title="@string/mobile_settings_cat_system"
        app:iconSpaceReserved="false">

        <Preference
            android:icon="@drawable/tv_ic_cloud"
            android:key="check_updates"
            android:title="@string/check_updates"
            app:singleLineTitle="false" />

        <Preference
            android:key="update_settings"
            android:title="@string/update_settings"
            app:iconSpaceReserved="false"
            app:singleLineTitle="false" />

        <Preference
            android:icon="@drawable/tv_ic_key"
            android:key="api_token_settings"
            android:title="@string/api_token_settings"
            app:singleLineTitle="false" />

        <ListPreference
            android:defaultValue="OkHttp"
            android:entries="@array/networkLibraryEntries"
            android:entryValues="@array/networkLibraryEntries"
            android:key="network_library"
            android:summary="%s"
            android:title="@string/network_library"
            app:iconSpaceReserved="false"
            app:singleLineTitle="false" />

        <Preference
            android:icon="@drawable/tv_ic_bug"
            android:key="debug_settings"
            android:title="@string/debug_settings"
            app:singleLineTitle="false" />

        <Preference
            android:icon="@drawable/tv_ic_info"
            android:key="about_app"
            android:summary="XtraTV forked from https://github.com/crackededed/Xtra by razeN with AI"
            android:title="@string/tv_settings_section_about"
            app:singleLineTitle="false" />

        <Preference
            android:icon="@drawable/tv_ic_list"
            android:key="about_changelog"
            android:summary="@string/tv_about_changelog_summary"
            android:title="@string/tv_about_changelog"
            app:singleLineTitle="false" />

    </PreferenceCategory>

</androidx.preference.PreferenceScreen>
