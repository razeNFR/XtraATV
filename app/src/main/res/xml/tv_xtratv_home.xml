<?xml version="1.0" encoding="utf-8"?>
<androidx.preference.PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <SwitchPreferenceCompat
        android:defaultValue="false"
        android:key="tv_hide_menu_on_launch"
        android:summary="@string/tv_hide_menu_on_launch_summary"
        android:title="@string/tv_hide_menu_on_launch"
        app:iconSpaceReserved="false"
        app:singleLineTitle="false" />

    <Preference
        android:key="tv_home_rows"
        android:persistent="false"
        android:summary="@string/tv_home_rows_summary"
        android:title="@string/tv_home_rows"
        app:iconSpaceReserved="false"
        app:singleLineTitle="false" />

    <SwitchPreferenceCompat
        android:defaultValue="false"
        android:key="tv_home_followed_show_all"
        android:summary="@string/tv_home_followed_show_all_summary"
        android:title="@string/tv_home_followed_show_all"
        app:iconSpaceReserved="false"
        app:singleLineTitle="false" />

    <ListPreference
        android:defaultValue="all"
        android:entries="@array/tvRecentChannelsFilterEntries"
        android:entryValues="@array/tvRecentChannelsFilterValues"
        android:key="tv_recent_channels_filter"
        android:summary="%s"
        android:title="@string/tv_recent_channels_filter"
        app:iconSpaceReserved="false"
        app:singleLineTitle="false" />

    <Preference
        android:key="tv_clear_recent_channels"
        android:persistent="false"
        android:summary="@string/tv_recent_channels_clear_summary"
        android:title="@string/tv_recent_channels_clear"
        app:iconSpaceReserved="false"
        app:singleLineTitle="false" />

    <Preference
        android:key="tv_favorites"
        android:title="@string/tv_favorites"
        app:iconSpaceReserved="false"
        app:singleLineTitle="false" />

    <Preference
        android:key="tv_blacklist"
        android:persistent="false"
        android:summary="@string/tv_blacklist_summary_empty"
        android:title="@string/tv_blacklist_title"
        app:iconSpaceReserved="false"
        app:singleLineTitle="false" />

</androidx.preference.PreferenceScreen>
