<?xml version="1.0" encoding="utf-8"?>
<!-- TV multi-stream: "Validate" button over the row, solid green like the check badges so it stands out over the video -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape>
            <solid android:color="#FFFFFFFF" />
            <stroke android:width="3dp" android:color="#FF22C55E" />
            <corners android:radius="24dp" />
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="#FF16A34A" />
            <corners android:radius="24dp" />
        </shape>
    </item>
</selector>
