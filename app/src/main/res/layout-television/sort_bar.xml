<?xml version="1.0" encoding="utf-8"?>
<!-- TV: sort and filters are a pill on the right of the header, the panel opens with OK -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_gravity="end"
    android:layout_marginTop="4dp"
    android:layout_marginEnd="12dp"
    android:layout_marginBottom="8dp"
    android:background="@drawable/tv_pill_background"
    android:clickable="true"
    android:duplicateParentState="false"
    android:focusable="true"
    android:paddingStart="18dp"
    android:paddingTop="9dp"
    android:paddingEnd="20dp"
    android:paddingBottom="9dp"
    android:visibility="gone"
    app:layout_scrollFlags="noScroll"
    tools:visibility="visible">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:duplicateParentState="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/sortByImage"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginEnd="10dp"
            android:duplicateParentState="true"
            android:src="@drawable/baseline_sort_black_24"
            app:tint="@color/tv_pill_text" />

        <TextView
            android:id="@+id/sortByText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:duplicateParentState="true"
            android:text="@string/sort"
            android:textColor="@color/tv_pill_text"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/sortText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:duplicateParentState="true"
            android:maxWidth="320dp"
            android:maxLines="1"
            android:ellipsize="end"
            android:textColor="@color/tv_pill_text"
            android:textSize="15sp"
            tools:text="@string/all_time" />

        <TextView
            android:id="@+id/filtersText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:duplicateParentState="true"
            android:maxWidth="360dp"
            android:maxLines="1"
            android:ellipsize="end"
            android:textColor="@color/tv_pill_text"
            android:textSize="15sp"
            android:visibility="gone" />
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
