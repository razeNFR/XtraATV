<?xml version="1.0" encoding="utf-8"?>
<!-- TV player controls: info on top, seek bar and a single row of buttons at the bottom, all reachable with the D-pad -->
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:alpha="0"
    android:visibility="gone"
    tools:alpha="1"
    tools:visibility="visible">

    <View
        android:layout_width="match_parent"
        android:layout_height="200dp"
        android:layout_alignParentTop="true"
        android:background="@drawable/tv_player_scrim_top" />

    <View
        android:layout_width="match_parent"
        android:layout_height="220dp"
        android:layout_alignParentBottom="true"
        android:background="@drawable/tv_player_scrim_bottom" />

    <LinearLayout
        android:id="@+id/topLeftLayout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentStart="true"
        android:layout_alignParentTop="true"
        android:layout_marginStart="@dimen/tv_overscan_horizontal"
        android:layout_marginTop="@dimen/tv_overscan_vertical"
        android:layout_marginEnd="@dimen/tv_overscan_horizontal">

        <LinearLayout
            android:id="@+id/infoLayout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
                        android:layout_marginEnd="10dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/channel"
                android:background="@drawable/player_control_background"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:layout_marginBottom="1dp"
                android:ellipsize="end"
                android:gravity="center_vertical|start"
                android:maxLines="1"
                android:textColor="@android:color/white"
                android:textSize="26sp"
                android:visibility="gone"
                app:autoSizeMaxTextSize="26sp"
                app:autoSizeMinTextSize="10sp"
                app:autoSizeStepGranularity="1sp"
                app:autoSizeTextType="uniform"
                tools:text="channel"
                tools:visibility="visible" />

            <TextView
                android:id="@+id/title"
                android:background="@drawable/player_control_background"
                android:layout_width="wrap_content"
                android:layout_height="24dp"
                android:layout_marginBottom="1dp"
                android:ellipsize="end"
                android:gravity="center_vertical|start"
                android:maxLines="1"
                android:textColor="@android:color/white"
                android:textSize="18sp"
                android:visibility="gone"
                app:autoSizeMaxTextSize="18sp"
                app:autoSizeMinTextSize="7sp"
                app:autoSizeStepGranularity="1sp"
                app:autoSizeTextType="uniform"
                tools:text="title"
                tools:visibility="visible" />

            <TextView
                android:id="@+id/category"
                android:background="@drawable/player_control_background"
                android:layout_width="wrap_content"
                android:layout_height="20dp"
                android:layout_marginBottom="1dp"
                android:ellipsize="end"
                android:gravity="center_vertical|start"
                android:maxLines="1"
                android:textColor="@android:color/white"
                android:textSize="15sp"
                android:visibility="gone"
                app:autoSizeMaxTextSize="15sp"
                app:autoSizeMinTextSize="6sp"
                app:autoSizeStepGranularity="1sp"
                app:autoSizeTextType="uniform"
                tools:text="game"
                tools:visibility="visible" />

        </LinearLayout>

    </LinearLayout>

    <LinearLayout
        android:id="@+id/streamInfoLayout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/topLeftLayout"
        android:layout_alignParentStart="true"
        android:layout_marginStart="@dimen/tv_overscan_horizontal">

        <LinearLayout
            android:id="@+id/uptimeLayout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="6dp"
            android:visibility="gone"
            tools:visibility="visible">

            <ImageView
                android:id="@+id/uptimeIcon"
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:layout_marginTop="9dp"
                android:layout_marginEnd="4dp"
                android:background="@drawable/player_control_background"
                android:src="@drawable/baseline_circle_24"
                android:visibility="gone"
                app:tint="@color/liveStreamRed"
                tools:visibility="visible" />

            <Chronometer
                android:id="@+id/uptimeTimer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:layout_marginBottom="7dp"
                android:textColor="@android:color/white" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/viewersLayout"
            android:background="@drawable/player_control_background"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">

            <ImageView
                android:id="@+id/viewersIcon"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:background="@drawable/player_control_background"
                android:src="@drawable/baseline_person_black_24"
                android:visibility="gone"
                app:tint="@android:color/white"
                tools:visibility="visible" />

            <TextView
                android:id="@+id/viewersText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:layout_marginBottom="7dp"
                android:textColor="@android:color/white"
                tools:text="13.3K" />

        </LinearLayout>

        <TextView
            android:id="@+id/tvQualityInfo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:layout_marginStart="10dp"
            android:background="@drawable/tv_badge_background"
            android:paddingStart="6dp"
            android:paddingTop="2dp"
            android:paddingEnd="6dp"
            android:paddingBottom="2dp"
            android:textColor="@android:color/white"
            android:textSize="12sp"
            android:textStyle="bold"
            android:visibility="gone"
            tools:text="1080p60"
            tools:visibility="visible" />

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_marginStart="@dimen/tv_overscan_horizontal"
        android:layout_marginEnd="@dimen/tv_overscan_horizontal"
        android:layout_marginBottom="@dimen/tv_overscan_vertical"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/position"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="56dp"
                android:gravity="start"
                android:textColor="@android:color/white"
                android:textSize="15sp"
                tools:text="12:16" />

            <LinearLayout
                android:id="@+id/bottomLayout"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1">

                <androidx.media3.ui.DefaultTimeBar
                    android:id="@+id/progressBar"
                    android:layout_width="match_parent"
                    android:layout_height="32dp"
                    android:focusable="true"
                    app:bar_height="5dp"
                    app:scrubber_enabled_size="16dp"
                    app:scrubber_dragged_size="18dp"
                    app:played_color="?attr/colorPrimary"
                    app:scrubber_color="@android:color/white"
                    app:unplayed_color="#55FFFFFF"
                    app:buffered_color="#88FFFFFF" />

            </LinearLayout>

            <TextView
                android:id="@+id/duration"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="56dp"
                android:gravity="end"
                android:textColor="@android:color/white"
                android:textSize="15sp"
                tools:text="1:12:16" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical">

            <LinearLayout
                android:id="@+id/bottomLeftLayout"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical">

                <ImageButton
                    android:id="@+id/restart"
                    android:layout_width="@dimen/player_button_size"
                    android:layout_height="@dimen/player_button_size"
                    android:layout_marginStart="2dp"
                    android:layout_marginEnd="2dp"
                    android:background="@drawable/player_control_background"
                    android:src="@drawable/baseline_replay_black_24"
                    android:visibility="gone"
                    app:tint="@android:color/white"
                    tools:visibility="visible" />
                <ImageButton
                    android:id="@+id/seekLive"
                    android:layout_width="@dimen/player_button_size"
                    android:layout_height="@dimen/player_button_size"
                    android:layout_marginStart="2dp"
                    android:layout_marginEnd="2dp"
                    android:background="@drawable/player_control_background"
                    android:src="@drawable/exo_icon_fastforward"
                    android:visibility="gone"
                    app:tint="@android:color/white"
                    tools:visibility="visible" />
                <Button
                    android:id="@+id/rewind"
                    android:layout_width="@dimen/player_button_size"
                    android:layout_height="@dimen/player_button_size"
                    android:layout_marginStart="2dp"
                    android:layout_marginEnd="2dp"
                    android:background="@drawable/player_control_background"
                    android:foreground="@drawable/exo_styled_controls_rewind"
                    android:gravity="center|bottom"
                    android:insetBottom="0dp"
                    android:paddingLeft="0dp"
                    android:paddingRight="0dp"
                    android:paddingBottom="20dp"
                    android:textColor="@android:color/white"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    app:backgroundTint="@android:color/white"
                    app:tint="@android:color/white"
                    tools:text="10" />
                <ImageButton
                    android:id="@+id/playPause"
                    android:layout_width="@dimen/player_play_button_size"
                    android:layout_height="@dimen/player_play_button_size"
                    android:layout_marginStart="2dp"
                    android:layout_marginEnd="2dp"
                    android:background="@drawable/player_control_background"
                    android:src="@drawable/baseline_play_arrow_black_48"
                    app:tint="@android:color/white" />
                <Button
                    android:id="@+id/fastForward"
                    android:layout_width="@dimen/player_button_size"
                    android:layout_height="@dimen/player_button_size"
                    android:layout_marginStart="2dp"
                    android:layout_marginEnd="2dp"
                    android:background="@drawable/player_control_background"
                    android:foreground="@drawable/exo_styled_controls_fastforward"
                    android:gravity="center|bottom"
                    android:insetBottom="0dp"
                    android:paddingLeft="0dp"
                    android:paddingRight="0dp"
                    android:paddingBottom="20dp"
                    android:textColor="@android:color/white"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    app:backgroundTint="@android:color/white"
                    app:tint="@android:color/white"
                    tools:text="10" />
                <ImageButton
                    android:id="@+id/vodGames"
                    android:layout_width="@dimen/player_button_size"
                    android:layout_height="@dimen/player_button_size"
                    android:layout_marginStart="2dp"
                    android:layout_marginEnd="2dp"
                    android:background="@drawable/player_control_background"
                    android:src="@drawable/baseline_format_list_bulleted_black_24"
                    android:visibility="gone"
                    app:tint="@android:color/white"
                    tools:visibility="visible" />

            </LinearLayout>

            <Space
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <HorizontalScrollView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/bottomRightLayout"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical">

                    <ImageButton
                        android:id="@+id/streamList"
                        android:layout_width="@dimen/player_button_size"
                        android:layout_height="@dimen/player_button_size"
                        android:layout_marginStart="2dp"
                        android:layout_marginEnd="2dp"
                        android:background="@drawable/player_control_background"
                        android:contentDescription="@string/tv_switch_stream"
                        android:src="@drawable/tv_ic_streamers"
                        android:visibility="gone"
                        app:tint="@android:color/white"
                        tools:visibility="visible" />

                    <ImageButton
                        android:id="@+id/quality"
                        android:layout_width="@dimen/player_button_size"
                        android:layout_height="@dimen/player_button_size"
                        android:layout_marginStart="2dp"
                        android:layout_marginEnd="2dp"
                        android:background="@drawable/player_control_background"
                        android:src="@drawable/tv_ic_hd"
                        android:visibility="gone"
                        app:tint="@android:color/white"
                        tools:visibility="visible" />
                        <ImageButton
                        android:id="@+id/speed"
                        android:layout_width="@dimen/player_button_size"
                        android:layout_height="@dimen/player_button_size"
                        android:layout_marginStart="2dp"
                        android:layout_marginEnd="2dp"
                        android:background="@drawable/player_control_background"
                        android:src="@drawable/exo_ic_speed"
                        android:visibility="gone"
                        app:tint="@android:color/white"
                        tools:visibility="visible" />
                        <ImageButton
                        android:id="@+id/subtitles"
                        android:layout_width="@dimen/player_button_size"
                        android:layout_height="@dimen/player_button_size"
                        android:layout_marginStart="2dp"
                        android:layout_marginEnd="2dp"
                        android:background="@drawable/player_control_background"
                        android:src="@drawable/exo_ic_subtitle_off"
                        android:visibility="gone"
                        app:tint="@android:color/white"
                        tools:visibility="visible" />
                        <ImageButton
                        android:id="@+id/volume"
                        android:layout_width="@dimen/player_button_size"
                        android:layout_height="@dimen/player_button_size"
                        android:layout_marginStart="2dp"
                        android:layout_marginEnd="2dp"
                        android:background="@drawable/player_control_background"
                        android:src="@drawable/baseline_volume_up_black_24"
                        android:visibility="gone"
                        app:tint="@android:color/white"
                        tools:visibility="visible" />
                        <ImageButton
                        android:id="@+id/audioOnly"
                        android:layout_width="@dimen/player_button_size"
                        android:layout_height="@dimen/player_button_size"
                        android:layout_marginStart="2dp"
                        android:layout_marginEnd="2dp"
                        android:background="@drawable/player_control_background"
                        android:src="@drawable/baseline_audiotrack_black_24"
                        android:visibility="gone"
                        app:tint="@android:color/white"
                        tools:visibility="visible" />
                        <ImageButton
                        android:id="@+id/audioCompressor"
                        android:layout_width="@dimen/player_button_size"
                        android:layout_height="@dimen/player_button_size"
                        android:layout_marginStart="2dp"
                        android:layout_marginEnd="2dp"
                        android:background="@drawable/player_control_background"
                        android:src="@drawable/baseline_audio_compressor_off_24dp"
                        android:visibility="gone"
                        app:tint="@android:color/white"
                        tools:visibility="visible" />
                        <ImageButton
                        android:id="@+id/toggleChat"
                        android:layout_width="@dimen/player_button_size"
                        android:layout_height="@dimen/player_button_size"
                        android:layout_marginStart="2dp"
                        android:layout_marginEnd="2dp"
                        android:background="@drawable/player_control_background"
                        android:src="@drawable/baseline_speaker_notes_black_24"
                        android:visibility="gone"
                        app:tint="@android:color/white"
                        tools:visibility="visible" />
                        <ImageButton
                        android:id="@+id/toggleChatInput"
                        android:layout_width="@dimen/player_button_size"
                        android:layout_height="@dimen/player_button_size"
                        android:layout_marginStart="2dp"
                        android:layout_marginEnd="2dp"
                        android:background="@drawable/player_control_background"
                        android:src="@drawable/baseline_keyboard_black_24"
                        android:visibility="gone"
                        app:tint="@android:color/white"
                        tools:visibility="visible" />
                        <ImageButton
                        android:id="@+id/follow"
                        android:layout_width="@dimen/player_button_size"
                        android:layout_height="@dimen/player_button_size"
                        android:layout_marginStart="2dp"
                        android:layout_marginEnd="2dp"
                        android:background="@drawable/player_control_background"
                        android:src="@drawable/baseline_favorite_border_black_24"
                        android:visibility="gone"
                        app:tint="@android:color/white"
                        tools:visibility="visible" />
                        <ImageButton
                        android:id="@+id/download"
                        android:layout_width="@dimen/player_button_size"
                        android:layout_height="@dimen/player_button_size"
                        android:layout_marginStart="2dp"
                        android:layout_marginEnd="2dp"
                        android:background="@drawable/player_control_background"
                        android:src="@drawable/ic_file_download_black_24dp"
                        android:visibility="gone"
                        app:tint="@android:color/white"
                        tools:visibility="visible" />
                        <ImageButton
                        android:id="@+id/sleepTimer"
                        android:layout_width="@dimen/player_button_size"
                        android:layout_height="@dimen/player_button_size"
                        android:layout_marginStart="2dp"
                        android:layout_marginEnd="2dp"
                        android:background="@drawable/player_control_background"
                        android:src="@drawable/baseline_alarm_black_24"
                        android:visibility="gone"
                        app:tint="@android:color/white"
                        tools:visibility="visible" />
                        <ImageButton
                        android:id="@+id/aspectRatio"
                        android:layout_width="@dimen/player_button_size"
                        android:layout_height="@dimen/player_button_size"
                        android:layout_marginStart="2dp"
                        android:layout_marginEnd="2dp"
                        android:background="@drawable/player_control_background"
                        android:src="@drawable/baseline_aspect_ratio_black_24"
                        android:visibility="gone"
                        app:tint="@android:color/white"
                        tools:visibility="visible" />
                    <ImageButton
                        android:id="@+id/multiStream"
                        android:layout_width="@dimen/player_button_size"
                        android:layout_height="@dimen/player_button_size"
                        android:layout_marginStart="2dp"
                        android:layout_marginEnd="2dp"
                        android:background="@drawable/player_control_background"
                        android:contentDescription="@string/tv_multistream"
                        android:src="@drawable/tv_ic_multistream"
                        android:visibility="gone"
                        app:tint="@android:color/white"
                        tools:visibility="visible" />

                    <ImageButton
                        android:id="@+id/chatMessage"
                        android:layout_width="@dimen/player_button_size"
                        android:layout_height="@dimen/player_button_size"
                        android:layout_marginStart="2dp"
                        android:layout_marginEnd="2dp"
                        android:background="@drawable/player_control_background"
                        android:contentDescription="@string/tv_write_message"
                        android:src="@drawable/tv_ic_chat_send"
                        android:visibility="gone"
                        app:tint="@android:color/white"
                        tools:visibility="visible" />

                    <ImageButton
                        android:id="@+id/chatLayoutSettings"
                        android:layout_width="@dimen/player_button_size"
                        android:layout_height="@dimen/player_button_size"
                        android:layout_marginStart="2dp"
                        android:layout_marginEnd="2dp"
                        android:background="@drawable/player_control_background"
                        android:contentDescription="@string/tv_chat_layout"
                        android:src="@drawable/tv_ic_chat_layout"
                        android:visibility="gone"
                        app:tint="@android:color/white"
                        tools:visibility="visible" />

                    <ImageButton
                        android:id="@+id/statsForNerds"
                        android:layout_width="@dimen/player_button_size"
                        android:layout_height="@dimen/player_button_size"
                        android:layout_marginStart="2dp"
                        android:layout_marginEnd="2dp"
                        android:background="@drawable/player_control_background"
                        android:contentDescription="@string/tv_stats_for_nerds"
                        android:src="@drawable/tv_ic_stats"
                        app:tint="@android:color/white" />

                        <ImageButton
                        android:id="@+id/menu"
                        android:layout_width="@dimen/player_button_size"
                        android:layout_height="@dimen/player_button_size"
                        android:layout_marginStart="2dp"
                        android:layout_marginEnd="2dp"
                        android:background="@drawable/player_control_background"
                        android:src="@drawable/baseline_settings_black_24"
                        android:visibility="gone"
                        app:tint="@android:color/white"
                        tools:visibility="visible" />
                        <ImageButton
                        android:id="@+id/minimize"
                        android:layout_width="@dimen/player_button_size"
                        android:layout_height="@dimen/player_button_size"
                        android:layout_marginStart="2dp"
                        android:layout_marginEnd="2dp"
                        android:background="@drawable/player_control_background"
                        android:src="@drawable/baseline_expand_more_black_48"
                        android:visibility="gone"
                        app:tint="@android:color/white"
                        tools:visibility="visible" />
                        <ImageButton
                        android:id="@+id/fullscreen"
                        android:layout_width="@dimen/player_button_size"
                        android:layout_height="@dimen/player_button_size"
                        android:layout_marginStart="2dp"
                        android:layout_marginEnd="2dp"
                        android:background="@drawable/player_control_background"
                        android:src="@drawable/baseline_fullscreen_black_24"
                        android:visibility="gone"
                        app:tint="@android:color/white"
                        tools:visibility="visible" />

                    <LinearLayout
                        android:id="@+id/topRightLayout"
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:visibility="gone" />

                </LinearLayout>
            </HorizontalScrollView>
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/tvTooltip"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/tv_tooltip_background"
        android:elevation="4dp"
        android:paddingStart="10dp"
        android:paddingTop="4dp"
        android:paddingEnd="10dp"
        android:paddingBottom="4dp"
        android:textColor="@android:color/black"
        android:textSize="13sp"
        android:visibility="invisible"
        tools:text="Quality" />

</RelativeLayout>
