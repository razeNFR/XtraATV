<?xml version="1.0" encoding="utf-8"?>
<!--
  TV player controls, in the style of the Nuvio player: title, channel and category on top, the time on the right,
  badges (viewers, quality, uptime) over a thin timeline, then one row of round buttons, the focused one is a white disc.
-->
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:alpha="0"
    android:visibility="gone"
    tools:alpha="1"
    tools:visibility="visible">

    <View
        android:layout_width="match_parent"
        android:layout_height="220dp"
        android:layout_alignParentTop="true"
        android:background="@drawable/tv_player_scrim_top" />

    <View
        android:layout_width="match_parent"
        android:layout_height="260dp"
        android:layout_alignParentBottom="true"
        android:background="@drawable/tv_player_scrim_bottom" />

    <LinearLayout
        android:id="@+id/topLeftLayout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentStart="true"
        android:layout_alignParentTop="true"
        android:layout_toStartOf="@+id/tvClock"
        android:layout_marginStart="@dimen/tv_overscan_horizontal"
        android:layout_marginTop="@dimen/tv_overscan_vertical"
        android:layout_marginEnd="24dp">

        <LinearLayout
            android:id="@+id/infoLayout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:ellipsize="end"
                android:maxLines="2"
                android:shadowColor="#CC000000"
                android:shadowDy="2"
                android:shadowRadius="6"
                android:textColor="@android:color/white"
                android:textSize="28sp"
                android:textStyle="bold"
                android:visibility="gone"
                tools:text="Stream title"
                tools:visibility="visible" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/tvChannelAvatar"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_marginEnd="4dp"
                    android:visibility="gone"
                    tools:visibility="visible" />

                <TextView
                    android:id="@+id/channel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/tv_player_link_background"
                    android:ellipsize="end"
                    android:focusable="true"
                    android:maxLines="1"
                    android:paddingStart="10dp"
                    android:paddingTop="4dp"
                    android:paddingEnd="10dp"
                    android:paddingBottom="4dp"
                    android:textColor="@color/tv_player_link_text"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:visibility="gone"
                    tools:text="channel"
                    tools:visibility="visible" />

                <TextView
                    android:id="@+id/tvCategorySeparator"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="2dp"
                    android:layout_marginEnd="6dp"
                    android:text="¦"
                    android:textColor="#B3FFFFFF"
                    android:textSize="20sp"
                    android:visibility="gone"
                    tools:visibility="visible" />

                <ImageView
                    android:id="@+id/tvCategoryAvatar"
                    android:layout_width="22dp"
                    android:layout_height="30dp"
                    android:layout_marginEnd="2dp"
                    android:scaleType="centerCrop"
                    android:visibility="gone"
                    tools:visibility="visible" />

                <TextView
                    android:id="@+id/category"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/tv_player_link_background"
                    android:ellipsize="end"
                    android:focusable="true"
                    android:maxLines="1"
                    android:paddingStart="8dp"
                    android:paddingTop="3dp"
                    android:paddingEnd="8dp"
                    android:paddingBottom="3dp"
                    android:textColor="@color/tv_player_link_text"
                    android:textSize="16sp"
                    android:visibility="gone"
                    tools:text="Just Chatting"
                    tools:visibility="visible" />

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

    <TextClock
        android:id="@+id/tvClock"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentEnd="true"
        android:layout_alignParentTop="true"
        android:layout_marginTop="@dimen/tv_overscan_vertical"
        android:layout_marginEnd="@dimen/tv_overscan_horizontal"
        android:shadowColor="#E6000000"
        android:shadowDy="2"
        android:shadowRadius="8"
        android:textColor="@android:color/white"
        android:textSize="28sp"
        android:textStyle="bold"
        android:visibility="gone"
        tools:visibility="visible" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_marginStart="@dimen/tv_overscan_horizontal"
        android:layout_marginEnd="@dimen/tv_overscan_horizontal"
        android:layout_marginBottom="@dimen/tv_overscan_vertical"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/streamInfoLayout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/viewersLayout"
                android:layout_width="wrap_content"
                android:layout_height="28dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/tv_player_badge_background"
                android:gravity="center_vertical"
                android:paddingStart="10dp"
                android:paddingEnd="12dp"
                android:visibility="gone"
                tools:visibility="visible">

                <ImageView
                    android:id="@+id/viewersIcon"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_marginEnd="6dp"
                    android:src="@drawable/tv_ic_eye"
                    android:visibility="gone"
                    app:tint="@android:color/white"
                    tools:visibility="visible" />

                <TextView
                    android:id="@+id/viewersText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@android:color/white"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    tools:text="13.3K" />

            </LinearLayout>

            <TextView
                android:id="@+id/tvQualityInfo"
                android:layout_width="wrap_content"
                android:layout_height="28dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/tv_player_badge_background"
                android:gravity="center"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:textColor="@android:color/white"
                android:textSize="14sp"
                android:textStyle="bold"
                android:visibility="gone"
                tools:text="1080p60"
                tools:visibility="visible" />

            <LinearLayout
                android:id="@+id/uptimeLayout"
                android:layout_width="wrap_content"
                android:layout_height="28dp"
                android:background="@drawable/tv_player_badge_background"
                android:gravity="center_vertical"
                android:paddingStart="10dp"
                android:paddingEnd="12dp"
                android:visibility="gone"
                tools:visibility="visible">

                <ImageView
                    android:id="@+id/uptimeIcon"
                    android:layout_width="10dp"
                    android:layout_height="10dp"
                    android:layout_marginEnd="6dp"
                    android:src="@drawable/baseline_circle_24"
                    android:visibility="gone"
                    app:tint="@color/liveStreamRed"
                    tools:visibility="visible" />

                <Chronometer
                    android:id="@+id/uptimeTimer"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@android:color/white"
                    android:textSize="14sp"
                    android:textStyle="bold" />

            </LinearLayout>

        </LinearLayout>

        <LinearLayout
            android:id="@+id/bottomLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <androidx.media3.ui.DefaultTimeBar
                android:id="@+id/progressBar"
                android:layout_width="match_parent"
                android:layout_height="26dp"
                android:focusable="true"
                app:bar_height="4dp"
                app:buffered_color="#66FFFFFF"
                app:played_color="?attr/colorPrimary"
                app:scrubber_color="@android:color/white"
                app:scrubber_dragged_size="16dp"
                app:scrubber_enabled_size="12dp"
                app:unplayed_color="#40FFFFFF" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center_vertical">

            <LinearLayout
                android:id="@+id/bottomLeftLayout"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical">

                    <ImageButton
                        android:id="@+id/restart"
                        android:layout_width="@dimen/player_button_size"
                        android:layout_height="@dimen/player_button_size"
                        android:layout_marginEnd="6dp"
                        android:background="@drawable/tv_player_button_background"
                        android:padding="@dimen/tv_player_button_padding"
                        android:scaleType="fitCenter"
                        android:src="@drawable/baseline_replay_black_24"
                        android:visibility="gone"
                        app:tint="@android:color/white"
                        tools:visibility="visible" />
                    <ImageButton
                        android:id="@+id/seekLive"
                        android:layout_width="@dimen/player_button_size"
                        android:layout_height="@dimen/player_button_size"
                        android:layout_marginEnd="6dp"
                        android:background="@drawable/tv_player_button_background"
                        android:padding="@dimen/tv_player_button_padding"
                        android:scaleType="fitCenter"
                        android:src="@drawable/exo_icon_fastforward"
                        android:visibility="gone"
                        app:tint="@android:color/white"
                        tools:visibility="visible" />
                    <Button
                        android:id="@+id/rewind"
                        android:layout_width="@dimen/player_button_size"
                        android:layout_height="@dimen/player_button_size"
                        android:layout_marginEnd="6dp"
                        android:background="@drawable/tv_player_button_background"
                        android:foreground="@drawable/exo_styled_controls_rewind"
                        android:gravity="center|bottom"
                        android:insetBottom="0dp"
                        android:paddingLeft="0dp"
                        android:paddingRight="0dp"
                        android:paddingBottom="18dp"
                        android:textColor="@android:color/white"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:visibility="gone"
                        app:backgroundTint="@null"
                        tools:text="10" />
                    <ImageButton
                        android:id="@+id/playPause"
                        android:layout_width="@dimen/player_button_size"
                        android:layout_height="@dimen/player_button_size"
                        android:layout_marginEnd="6dp"
                        android:background="@drawable/tv_player_button_background"
                        android:padding="@dimen/tv_player_button_padding"
                        android:scaleType="fitCenter"
                        android:src="@drawable/baseline_play_arrow_black_48"
                        app:tint="@android:color/white"
                        tools:visibility="visible" />
                    <Button
                        android:id="@+id/fastForward"
                        android:layout_width="@dimen/player_button_size"
                        android:layout_height="@dimen/player_button_size"
                        android:layout_marginEnd="6dp"
                        android:background="@drawable/tv_player_button_background"
                        android:foreground="@drawable/exo_styled_controls_fastforward"
                        android:gravity="center|bottom"
                        android:insetBottom="0dp"
                        android:paddingLeft="0dp"
                        android:paddingRight="0dp"
                        android:paddingBottom="18dp"
                        android:textColor="@android:color/white"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:visibility="gone"
                        app:backgroundTint="@null"
                        tools:text="10" />
                    <ImageButton
                        android:id="@+id/vodGames"
                        android:layout_width="@dimen/player_button_size"
                        android:layout_height="@dimen/player_button_size"
                        android:layout_marginEnd="6dp"
                        android:background="@drawable/tv_player_button_background"
                        android:padding="@dimen/tv_player_button_padding"
                        android:scaleType="fitCenter"
                        android:src="@drawable/baseline_format_list_bulleted_black_24"
                        android:visibility="gone"
                        app:tint="@android:color/white"
                        tools:visibility="visible" />

            </LinearLayout>

            <HorizontalScrollView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/bottomRightLayout"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical">

                    <ImageButton
                        android:id="@+id/streamList"
                        android:layout_width="@dimen/player_button_size"
                        android:layout_height="@dimen/player_button_size"
                        android:layout_marginEnd="6dp"
                        android:background="@drawable/tv_player_button_background"
                        android:padding="@dimen/tv_player_button_padding"
                        android:scaleType="fitCenter"
                        android:contentDescription="@string/tv_switch_stream"
                        android:src="@drawable/tv_ic_streamers"
                        android:visibility="gone"
                        app:tint="@android:color/white"
                        tools:visibility="visible" />
                    <ImageButton
                        android:id="@+id/multiStream"
                        android:layout_width="@dimen/player_button_size"
                        android:layout_height="@dimen/player_button_size"
                        android:layout_marginEnd="6dp"
                        android:background="@drawable/tv_player_button_background"
                        android:padding="@dimen/tv_player_button_padding"
                        android:scaleType="fitCenter"
                        android:contentDescription="@string/tv_multistream"
                        android:src="@drawable/tv_ic_multistream"
                        android:visibility="gone"
                        app:tint="@android:color/white"
                        tools:visibility="visible" />
                    <ImageButton
                        android:id="@+id/tvPipSettings"
                        android:layout_width="@dimen/player_button_size"
                        android:layout_height="@dimen/player_button_size"
                        android:layout_marginEnd="6dp"
                        android:background="@drawable/tv_player_button_background"
                        android:padding="@dimen/tv_player_button_padding"
                        android:scaleType="fitCenter"
                        android:contentDescription="@string/tv_pip_settings"
                        android:src="@drawable/tv_ic_pip"
                        android:visibility="gone"
                        app:tint="@android:color/white"
                        tools:visibility="visible" />
                    <ImageButton
                        android:id="@+id/quality"
                        android:layout_width="@dimen/player_button_size"
                        android:layout_height="@dimen/player_button_size"
                        android:layout_marginEnd="6dp"
                        android:background="@drawable/tv_player_button_background"
                        android:padding="@dimen/tv_player_button_padding"
                        android:scaleType="fitCenter"
                        android:src="@drawable/tv_ic_hd"
                        android:visibility="gone"
                        app:tint="@android:color/white"
                        tools:visibility="visible" />
                    <ImageButton
                        android:id="@+id/speed"
                        android:layout_width="@dimen/player_button_size"
                        android:layout_height="@dimen/player_button_size"
                        android:layout_marginEnd="6dp"
                        android:background="@drawable/tv_player_button_background"
                        android:padding="@dimen/tv_player_button_padding"
                        android:scaleType="fitCenter"
                        android:src="@drawable/exo_ic_speed"
                        android:visibility="gone"
                        app:tint="@android:color/white"
                        tools:visibility="visible" />
                    <ImageButton
                        android:id="@+id/subtitles"
                        android:layout_width="@dimen/player_button_size"
                        android:layout_height="@dimen/player_button_size"
                        android:layout_marginEnd="6dp"
                        android:background="@drawable/tv_player_button_background"
                        android:padding="@dimen/tv_player_button_padding"
                        android:scaleType="fitCenter"
                        android:src="@drawable/exo_ic_subtitle_off"
                        android:visibility="gone"
                        app:tint="@android:color/white"
                        tools:visibility="visible" />
                    <ImageButton
                        android:id="@+id/volume"
                        android:layout_width="@dimen/player_button_size"
                        android:layout_height="@dimen/player_button_size"
                        android:layout_marginEnd="6dp"
                        android:background="@drawable/tv_player_button_background"
                        android:padding="@dimen/tv_player_button_padding"
                        android:scaleType="fitCenter"
                        android:src="@drawable/tv_ic_volume"
                        android:visibility="gone"
                        app:tint="@android:color/white"
                        tools:visibility="visible" />
                    <ImageButton
                        android:id="@+id/audioOnly"
                        android:layout_width="@dimen/player_button_size"
                        android:layout_height="@dimen/player_button_size"
                        android:layout_marginEnd="6dp"
                        android:background="@drawable/tv_player_button_background"
                        android:padding="@dimen/tv_player_button_padding"
                        android:scaleType="fitCenter"
                        android:src="@drawable/baseline_audiotrack_black_24"
                        android:visibility="gone"
                        app:tint="@android:color/white"
                        tools:visibility="visible" />
                    <ImageButton
                        android:id="@+id/audioCompressor"
                        android:layout_width="@dimen/player_button_size"
                        android:layout_height="@dimen/player_button_size"
                        android:layout_marginEnd="6dp"
                        android:background="@drawable/tv_player_button_background"
                        android:padding="@dimen/tv_player_button_padding"
                        android:scaleType="fitCenter"
                        android:src="@drawable/baseline_audio_compressor_off_24dp"
                        android:visibility="gone"
                        app:tint="@android:color/white"
                        tools:visibility="visible" />
                    <ImageButton
                        android:id="@+id/toggleChat"
                        android:layout_width="@dimen/player_button_size"
                        android:layout_height="@dimen/player_button_size"
                        android:layout_marginEnd="6dp"
                        android:background="@drawable/tv_player_button_background"
                        android:padding="@dimen/tv_player_button_padding"
                        android:scaleType="fitCenter"
                        android:src="@drawable/baseline_speaker_notes_black_24"
                        android:visibility="gone"
                        app:tint="@android:color/white"
                        tools:visibility="visible" />
                    <ImageButton
                        android:id="@+id/toggleChatInput"
                        android:layout_width="@dimen/player_button_size"
                        android:layout_height="@dimen/player_button_size"
                        android:layout_marginEnd="6dp"
                        android:background="@drawable/tv_player_button_background"
                        android:padding="@dimen/tv_player_button_padding"
                        android:scaleType="fitCenter"
                        android:src="@drawable/baseline_keyboard_black_24"
                        android:visibility="gone"
                        app:tint="@android:color/white"
                        tools:visibility="visible" />
                    <ImageButton
                        android:id="@+id/chatMessage"
                        android:layout_width="@dimen/player_button_size"
                        android:layout_height="@dimen/player_button_size"
                        android:layout_marginEnd="6dp"
                        android:background="@drawable/tv_player_button_background"
                        android:padding="@dimen/tv_player_button_padding"
                        android:scaleType="fitCenter"
                        android:contentDescription="@string/tv_write_message"
                        android:src="@drawable/tv_ic_chat_send"
                        android:visibility="gone"
                        app:tint="@android:color/white"
                        tools:visibility="visible" />
                    <ImageButton
                        android:id="@+id/chatLayoutSettings"
                        android:layout_width="@dimen/player_button_size"
                        android:layout_height="@dimen/player_button_size"
                        android:layout_marginEnd="6dp"
                        android:background="@drawable/tv_player_button_background"
                        android:padding="@dimen/tv_player_button_padding"
                        android:scaleType="fitCenter"
                        android:contentDescription="@string/tv_chat_layout"
                        android:src="@drawable/tv_ic_chat_layout"
                        android:visibility="gone"
                        app:tint="@android:color/white"
                        tools:visibility="visible" />
                    <ImageButton
                        android:id="@+id/follow"
                        android:layout_width="@dimen/player_button_size"
                        android:layout_height="@dimen/player_button_size"
                        android:layout_marginEnd="6dp"
                        android:background="@drawable/tv_player_button_background"
                        android:padding="@dimen/tv_player_button_padding"
                        android:scaleType="fitCenter"
                        android:src="@drawable/tv_ic_heart_outline"
                        android:visibility="gone"
                        app:tint="@android:color/white"
                        tools:visibility="visible" />
                    <ImageButton
                        android:id="@+id/download"
                        android:layout_width="@dimen/player_button_size"
                        android:layout_height="@dimen/player_button_size"
                        android:layout_marginEnd="6dp"
                        android:background="@drawable/tv_player_button_background"
                        android:padding="@dimen/tv_player_button_padding"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_file_download_black_24dp"
                        android:visibility="gone"
                        app:tint="@android:color/white"
                        tools:visibility="visible" />
                    <ImageButton
                        android:id="@+id/sleepTimer"
                        android:layout_width="@dimen/player_button_size"
                        android:layout_height="@dimen/player_button_size"
                        android:layout_marginEnd="6dp"
                        android:background="@drawable/tv_player_button_background"
                        android:padding="@dimen/tv_player_button_padding"
                        android:scaleType="fitCenter"
                        android:src="@drawable/baseline_alarm_black_24"
                        android:visibility="gone"
                        app:tint="@android:color/white"
                        tools:visibility="visible" />
                    <ImageButton
                        android:id="@+id/aspectRatio"
                        android:layout_width="@dimen/player_button_size"
                        android:layout_height="@dimen/player_button_size"
                        android:layout_marginEnd="6dp"
                        android:background="@drawable/tv_player_button_background"
                        android:padding="@dimen/tv_player_button_padding"
                        android:scaleType="fitCenter"
                        android:src="@drawable/baseline_aspect_ratio_black_24"
                        android:visibility="gone"
                        app:tint="@android:color/white"
                        tools:visibility="visible" />
                    <ImageButton
                        android:id="@+id/statsForNerds"
                        android:layout_width="@dimen/player_button_size"
                        android:layout_height="@dimen/player_button_size"
                        android:layout_marginEnd="6dp"
                        android:background="@drawable/tv_player_button_background"
                        android:padding="@dimen/tv_player_button_padding"
                        android:scaleType="fitCenter"
                        android:contentDescription="@string/tv_stats_for_nerds"
                        android:src="@drawable/tv_ic_stats"
                        app:tint="@android:color/white"
                        tools:visibility="visible" />
                    <ImageButton
                        android:id="@+id/menu"
                        android:layout_width="@dimen/player_button_size"
                        android:layout_height="@dimen/player_button_size"
                        android:layout_marginEnd="6dp"
                        android:background="@drawable/tv_player_button_background"
                        android:padding="@dimen/tv_player_button_padding"
                        android:scaleType="fitCenter"
                        android:src="@drawable/tv_ic_settings"
                        android:visibility="gone"
                        app:tint="@android:color/white"
                        tools:visibility="visible" />
                    <ImageButton
                        android:id="@+id/minimize"
                        android:layout_width="@dimen/player_button_size"
                        android:layout_height="@dimen/player_button_size"
                        android:layout_marginEnd="6dp"
                        android:background="@drawable/tv_player_button_background"
                        android:padding="@dimen/tv_player_button_padding"
                        android:scaleType="fitCenter"
                        android:src="@drawable/baseline_expand_more_black_48"
                        android:visibility="gone"
                        app:tint="@android:color/white"
                        tools:visibility="visible" />
                    <ImageButton
                        android:id="@+id/fullscreen"
                        android:layout_width="@dimen/player_button_size"
                        android:layout_height="@dimen/player_button_size"
                        android:layout_marginEnd="6dp"
                        android:background="@drawable/tv_player_button_background"
                        android:padding="@dimen/tv_player_button_padding"
                        android:scaleType="fitCenter"
                        android:src="@drawable/tv_ic_fullscreen"
                        android:visibility="gone"
                        app:tint="@android:color/white"
                        tools:visibility="visible" />

                    <LinearLayout
                        android:id="@+id/topRightLayout"
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:visibility="gone" />

                </LinearLayout>
            </HorizontalScrollView>

            <TextView
                android:id="@+id/position"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:shadowColor="#CC000000"
                android:shadowRadius="4"
                android:textColor="@android:color/white"
                android:textSize="16sp"
                tools:text="0:19" />

            <TextView
                android:id="@+id/tvTimeSeparator"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_marginEnd="6dp"
                android:text="/"
                android:textColor="#B3FFFFFF"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/duration"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:shadowColor="#CC000000"
                android:shadowRadius="4"
                android:textColor="#B3FFFFFF"
                android:textSize="16sp"
                tools:text="1:21:49" />

        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/tvTooltip"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/tv_tooltip_background"
        android:elevation="4dp"
        android:paddingStart="10dp"
        android:paddingTop="4dp"
        android:paddingEnd="10dp"
        android:paddingBottom="4dp"
        android:textColor="@android:color/black"
        android:textSize="13sp"
        android:visibility="invisible"
        tools:text="Quality" />

</RelativeLayout>
