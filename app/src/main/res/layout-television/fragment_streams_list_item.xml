<?xml version="1.0" encoding="utf-8"?>
<!-- TV stream card: 16:9 thumbnail with badges, avatar and single line texts -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="?attr/cardStyle"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/topLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:id="@+id/thumbnail"
                style="@style/Thumbnail"
                android:scaleType="centerCrop"
                android:visibility="gone"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                tools:src="@tools:sample/backgrounds/scenic"
                tools:visibility="visible" />

            <com.github.andreyasadchy.xtra.ui.view.TextWithShadow
                android:id="@+id/viewers"
                style="@style/TvThumbnailBadge"
                android:background="@drawable/tv_live_badge_background"
                android:visibility="gone"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                tools:text="13.3K viewers"
                tools:visibility="visible" />

            <com.github.andreyasadchy.xtra.ui.view.TextWithShadow
                android:id="@+id/uptime"
                style="@style/TvThumbnailBadge"
                android:visibility="gone"
                app:layout_constraintBottom_toBottomOf="@+id/thumbnail"
                app:layout_constraintEnd_toEndOf="parent"
                tools:text="8:21:33"
                tools:visibility="visible" />

            <ImageView
                android:id="@+id/userImage"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_marginStart="8dp"
                android:layout_marginTop="8dp"
                android:focusable="false"
                android:visibility="gone"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/thumbnail"
                tools:src="@tools:sample/backgrounds/scenic"
                tools:visibility="visible" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_marginTop="6dp"
                android:layout_marginEnd="8dp"
                android:layout_marginBottom="8dp"
                android:orientation="vertical"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@id/userImage"
                app:layout_constraintTop_toBottomOf="@id/thumbnail"
                app:layout_constraintVertical_bias="0.0">

                <TextView
                    android:id="@+id/title"
                    style="@style/TvCardTitle"
                    android:visibility="gone"
                    tools:text="@sample/streams.json/streams/channel/status"
                    tools:visibility="visible" />

                <TextView
                    android:id="@+id/username"
                    style="@style/TvCardSubtitle"
                    android:visibility="gone"
                    tools:text="@sample/streams.json/streams/channel/name"
                    tools:visibility="visible" />

                <TextView
                    android:id="@+id/gameName"
                    style="@style/TvCardSubtitle"
                    android:visibility="gone"
                    tools:text="@sample/games.json/top/game/name"
                    tools:visibility="visible" />
            </LinearLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- Tags are not shown on TV: they make the cards uneven -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/tagsLayout"
            android:layout_width="match_parent"
            android:layout_height="1px"
            android:alpha="0"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toBottomOf="@id/topLayout" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>
